# Compose ports
WEB_PORT=8080
BACKEND_PORT=8001
PGADMIN_PORT=5050

# Local development credentials only
POSTGRES_DB=mess_management
POSTGRES_USER=mess_user
POSTGRES_PASSWORD=mess_secret
PGADMIN_DEFAULT_EMAIL=admin@mess.local
PGADMIN_DEFAULT_PASSWORD=admin

# Set a real secret outside local development
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
NEXT_PUBLIC_API_URL=https://mess.czbd.dev/api/v1
EXPO_PUBLIC_API_URL=https://mess.czbd.dev/api/v1

# Cloudflare R2 (optional - falls back to local storage when unset).
# AWS_* variable names are also accepted by the backend as a fallback.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
